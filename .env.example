# Порт и адрес
PORT=3000
HOST=0.0.0.0
# Где лежат база и файлы (смонтируйте сюда постоянный диск)
DATA_DIR=./data
# Первый администратор (создаётся один раз, если пользователей ещё нет).
# Без ADMIN_PASSWORD сгенерируется временный пароль и выведется в лог при первом запуске.
ADMIN_LOGIN=admin
ADMIN_NAME=Администратор
ADMIN_PASSWORD=
# 1 — только по HTTPS (обязательно в продакшене)
COOKIE_SECURE=0
# 1 — сервер стоит за своим прокси (nginx, Render) и доверяет X-Forwarded-For
TRUST_PROXY=0
# Максимальный размер файла, МБ
MAX_UPLOAD_MB=200
